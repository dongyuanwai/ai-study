# Copy to .env.local to enable personalized AI feedback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional override for the folder that contains AI大模型面试题库-*.md.
# Leave this unset locally and on Vercel. The app reads the parent of its
# working directory, which is `agent-docs` both in local dev and in the
# serverless function (cwd is `agent-docs/AI学习系统`).
# Do not set a relative path such as `agent-docs`: it is resolved from that
# cwd and will not find the files. If you must override it on Vercel, use the
# absolute path inside the function:
# AI_BANK_DIR=/var/task/agent-docs

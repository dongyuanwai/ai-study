{
  "name": "ai-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --turbopack",
    "build": "node scripts/generate-assets.mjs && next build --turbopack",
    "typecheck": "tsc --noEmit",
    "check:seo": "node scripts/check-seo.mjs",
    "check:sitemap:live": "node scripts/check-sitemap-live.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:import": "node scripts/import-questions.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

{
  "name": "ai-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-assets.mjs && next build --turbopack",
    "typecheck": "tsc --noEmit",
    "check:seo": "node scripts/check-rendered.mjs seo",
    "check:sitemap:live": "node scripts/check-sitemap-live.mjs",
    "check:analytics": "node scripts/check-rendered.mjs analytics",
    "test": "node --test tests/*.test.mjs",
    "data:import": "node scripts/import-questions.mjs",
    "db:seed": "node scripts/database/seed.mjs",
    "db:test": "node scripts/database/test-postgres.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3035",
    "check:site": "node scripts/check-rendered.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "langchain": "1.6.3",
    "@langchain/core": "1.3.6",
    "@langchain/openai": "1.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

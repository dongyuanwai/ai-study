# 本地开发地址；正式发布前再配置本站域名。
SITE_URL=http://127.0.0.1:3035
# 默认不允许搜索引擎索引；明确准备发布后才设置为 true。
ALLOW_INDEXING=false

# Supabase 项目地址和只读 Key；三项 Supabase 配置均仅在服务端读取。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 仅服务端写接口和本地工具使用；Secret Key 或旧版 service_role Key，禁止加 NEXT_PUBLIC_。
SUPABASE_SECRET_KEY=

# 增删改查写接口的管理员 Bearer Token，至少 32 字符，禁止公开。
ADMIN_API_TOKEN=

# 默认 AI（仅服务端）；与用户自己的模型配置独立。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_ID=
# 发给获准使用默认模型的人；与 ADMIN_API_TOKEN 分开。
AI_ACCESS_KEY=
